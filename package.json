{
  "name": "deepseek-box",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "DeepSeek Harness 插件中心：安装、更新与管理 DSH 插件，聚合插件索引源，并发布可订阅的 DSH 插件索引。",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "plugin-center",
    "plugin-manager",
    "plugin-market",
    "plugin-index",
    "vue",
    "typescript"
  ],
  "homepage": "https://github.com/Wcof/DeepSeekBox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wcof/DeepSeekBox.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icons/deepseekbox-plugin-center.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icons/deepseekbox-plugin-center.svg",
    "web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "cp web/index.json index.json && cp web/community.json community.json && node scripts/sync-self-entry.mjs && node scripts/validate-index.mjs index.json && node scripts/validate-index.mjs community.json && node scripts/validate-bundle.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "check:engines": "node scripts/check-engines.mjs",
    "community:scan": "node scripts/scan-dshhub.mjs --all",
    "community:build": "node scripts/build-community.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
