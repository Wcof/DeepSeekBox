{
  "name": "plugbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PlugBox 插件适配与管理工具：统一的插件协议与资源抽象，经适配层接入任意支持自定义插件的引擎层与智能体层工具。",
  "keywords": [
    "plugbox",
    "plugin-center",
    "plugin-manager",
    "plugin-registry",
    "plugin-adapter",
    "plugin-index",
    "engine-agnostic",
    "agent-tools",
    "vue",
    "typescript"
  ],
  "homepage": "https://github.com/Wcof/PlugBox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wcof/PlugBox.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icons/plugbox.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icons/plugbox.svg",
    "web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "cp web/index.json index.json && cp web/community.json community.json && node scripts/sync-self-entry.mjs && npm run validate:index index.json && npm run validate:index community.json && npm run validate:bundle && npm run check:pinned && npm run check:adapters",
    "validate:index": "node scripts/validate-index.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "check:engines": "node scripts/check-engines.mjs",
    "check:pinned": "node scripts/check-pinned-index.mjs",
    "check:adapters": "node scripts/check-adapters.mjs",
    "check:all": "npm run validate:bundle && npm run validate:index index.json && npm run validate:index community.json && npm run check:engines && npm run check:pinned && npm run check:adapters",
    "community:scan": "node scripts/scan-community-hub.mjs --all",
    "community:build": "node scripts/build-community.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
